rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function workspaceDoc(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn() && request.auth.uid in workspaceDoc(workspaceId).memberIds;
    }

    function isWorkspaceOwner(workspaceId) {
      return signedIn() && workspaceDoc(workspaceId).ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/collections/{collectionId} {
      allow read, write: if signedIn() && request.auth.uid == userId;

      match /nodes/{nodeId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /workspaces/{workspaceId} {
      // Use resource.data (not get()) so list queries like
      // memberIds array-contains uid / ownerId == uid are allowed.
      allow read: if signedIn() && (
        request.auth.uid in resource.data.memberIds
        || resource.data.ownerId == request.auth.uid
      );

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      allow delete: if isWorkspaceOwner(workspaceId);

      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberIds
        || (
          !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'updatedAt'])
          && exists(/databases/$(database)/documents/workspace_invites/$(resource.data.inviteCode))
          && get(/databases/$(database)/documents/workspace_invites/$(resource.data.inviteCode)).data.active == true
          && get(/databases/$(database)/documents/workspace_invites/$(resource.data.inviteCode)).data.workspaceId == workspaceId
        )
      );

      match /collections/{collectionId} {
        allow read, write: if isWorkspaceMember(workspaceId);

        match /nodes/{nodeId} {
          allow read, write: if isWorkspaceMember(workspaceId);
        }
      }

      match /nodes/{nodeId} {
        allow read, write: if isWorkspaceMember(workspaceId);
      }
    }

    match /workspace_invites/{inviteCode} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId))
        && isWorkspaceOwner(resource.data.workspaceId);
    }

    match /aiAnalysisUsage/{docId} {
      allow read, write: if signedIn() && docId.matches(request.auth.uid + '_.*');
    }

    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.kind in ['node', 'collection']
        && request.resource.data.origin in ['personal', 'workspace']
        && (
          (
            request.resource.data.origin == 'personal'
            && request.resource.data.workspaceId == null
          )
          || (
            request.resource.data.origin == 'workspace'
            && request.resource.data.workspaceId is string
            && isWorkspaceMember(request.resource.data.workspaceId)
          )
        )
        && (
          (
            request.resource.data.kind == 'node'
            && request.resource.data.nodeId is string
          )
          || (
            request.resource.data.kind == 'collection'
            && request.resource.data.collectionId is string
            && request.resource.data.nodeId == null
          )
        );

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.origin == resource.data.origin
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.collectionId == resource.data.collectionId
        && request.resource.data.nodeId == resource.data.nodeId;

      allow delete: if false;
    }
  }
}
